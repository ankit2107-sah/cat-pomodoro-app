{
  "name": "cat-pomodoro",
  "version": "1.1.0",
  "description": "Cat Pomodoro: a focus timer with tasks, history and a pixel cat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.catpomodoro.app",
    "productName": "Cat Pomodoro",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
